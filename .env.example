# Copia este archivo a .env y ajusta valores.

# Seguridad
# Secreto en archivo: secrets/secret_key

# Base de datos (compose ya usa db:5432 internamente)
DATABASE_URL=postgresql://postgres:postgres@db:5432/miacademia

# Marca
ACADEMY_NAME=Marca Atractora
# URL pública de la academia (enlaces en emails), ej. https://tudominio.com
PUBLIC_BASE_URL=
# Email del administrador para alertas de registro, bajas e impagos
ADMIN_EMAIL=
# Región de precio por defecto en landing: es | intl
DEFAULT_BILLING_REGION=es

# Stripe (opcional)
STRIPE_PUBLIC_KEY=
# Secreto en archivo: secrets/stripe_secret_key

# Webhooks externos
N8N_WEBHOOK_PREGUNTAS=
RECORDING_WEBHOOK_SECRET=

# Producción HTTPS (cookies seguras + cabeceras)
# SESSION_COOKIE_SECURE=true
# FORCE_HTTPS=true

# Worker recordatorios clases (segundos entre comprobaciones)
# REMINDER_INTERVAL_SEC=300

# Email (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Secretos en archivo:
# - secrets/mail_username
# - secrets/mail_password
